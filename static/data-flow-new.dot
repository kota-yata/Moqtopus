digraph moqtopus_data_flow {
  rankdir=TB;
  fontname="Helvetica";
  labelloc="t";
  label="moqtopus receive paths: new stream, packet on existing stream, datagram\n(one StreamSink per stream; sinks parse QUIC buffers in place)";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=9];

  // ---------------- MsQuic events ----------------
  subgraph cluster_transport {
    label="MsQuic callback thread";
    style="rounded"; color="#8888aa"; fontsize=11;

    ev_peer_stream [label="PEER_STREAM_STARTED", fillcolor="#e8f0ff"];
    ev_receive     [label="STREAM_EVENT_RECEIVE\nStreamContext wraps buffers as\nBytesView chunks (no copy)", fillcolor="#e8f0ff"];
    ev_datagram    [label="DATAGRAM_RECEIVED", fillcolor="#e8f0ff"];
  }

  // ---------------- New stream (cold) ----------------
  subgraph cluster_cold {
    label="COLD -- once per stream";
    style="rounded"; color="#cc8844"; fontsize=11;

    gate [label="PeerStreamGate::on_receive\nbuffer until classifiable", fillcolor="#fff3d6"];
    classify [shape=diamond, style=filled, fillcolor="#fff3d6", label="first varint /\nstream direction"];
    setup [label="SETUP stream:\nvalidate, session ready,\nignore later control msgs", fillcolor="#fff3d6"];
    bidi  [label="bidi request:\nreject with REQUEST_ERROR", fillcolor="#fff3d6"];
    padfetch [label="padding: verify zeros\nfetch: abort_receive", fillcolor="#fff3d6"];
    handoff [label="DataPlane::start_subgroup_stream\nset_sink(SubgroupReceiver)\nprefix bytes carried over", fillcolor="#ffe9c6"];
  }

  // ---------------- Existing stream (hot) ----------------
  subgraph cluster_hot {
    label="HOT -- every packet on an established subgroup stream";
    style="rounded"; color="#44aa44"; fontsize=11;

    receiver [label="SubgroupReceiver::on_receive\nCursor over QUIC buffer\n(stash only boundary tails)", fillcolor="#eef7ff"];
    parse    [label="parse objects in place\nroute + flags frozen at header", fillcolor="#eef7ff"];
    deliver  [label="DataPlane::deliver\nvalidate, then\nhandler->on_object(Object)\npayload = BytesView, valid during call", style="rounded,filled,bold", fillcolor="#c6f6c6"];
  }

  // ---------------- Subscription control ----------------
  fsm [label="SubscriptionFSM (bidi SUBSCRIBE stream sink)\nSUBSCRIBE_OK -> install_route(alias)\nPUBLISH_DONE / REQUEST_ERROR -> retire_route", fillcolor="#f0e6ff"];

  // ---------------- Datagrams ----------------
  dgram [label="DataPlane::on_datagram\nparse in place, find_route(alias)\nunknown alias: buffer/drop per policy", fillcolor="#eef7ff"];

  ev_peer_stream -> gate [label="set_sink(PeerStreamGate)"];
  gate -> classify;
  classify -> setup;
  classify -> bidi;
  classify -> padfetch;
  classify -> handoff [label="subgroup type", style=bold];
  handoff -> receiver [label="all later RECEIVEs", style=bold, color="#44aa44"];

  ev_receive -> gate [label="sink = gate", style=dashed];
  ev_receive -> receiver [label="sink = receiver", style=bold, color="#44aa44"];
  ev_receive -> fsm [label="sink = FSM", style=dashed];

  receiver -> parse -> deliver;
  fsm -> deliver [label="route table", style=dotted];

  ev_datagram -> dgram -> deliver;
}
